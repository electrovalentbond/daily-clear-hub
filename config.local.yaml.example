# plan/check/run --automas 可直接使用 AUTO-MAS 托管和自动发现的 B 服 ADB 设备。
# 下方示例用于需要手动指定托管或独立工具路径的场合。
# 手动使用时复制为 config.local.yaml，并按 docs/windows.md 配置上游工具。
# 先运行 check GAME 和 run GAME 检查单款游戏，再用 enabled: true 加入队列。
# 相对路径以仓库根目录为基准。要使用内置模板，可将对应游戏的 backend 改为 native，
# 并移除该游戏特有的上游字段。
games:
  honkai3:
    enabled: false
    backend: automas
    script_id: "填入 Maa_bbb 脚本 ID"
    timeout_sec: 1800
  starrail:
    enabled: false
    backend: march7th
    executable: "C:/Tools/March7thAssistant/m7a.exe"
    timeout_sec: 1800
  zzz:
    enabled: false
    backend: automas
    script_id: "填入绝区零一条龙脚本 ID"
    timeout_sec: 2400
  genshin:
    enabled: false
    backend: automas
    script_id: "填入 BetterGI 脚本 ID"
    timeout_sec: 3600
  pcr:
    enabled: false
    backend: pcr_script
    project_dir: "C:/Tools/pcr-script"
    executable: "C:/Tools/pcr-script/.venv/Scripts/python.exe"
    pcr_config: "C:/Tools/pcr-script/daily_config.yml"
    timeout_sec: 1800
  bhxy2:
    enabled: false
    backend: hka
    executable: "C:/Tools/Honkai2Automation/.venv/Scripts/python.exe"
    project_dir: "C:/Tools/Honkai2Automation"
    hka_config: "C:/Tools/Honkai2Automation/config.json"
    timeout_sec: 1800
  endfield:
    enabled: false
    backend: automas
    script_id: "填入 MaaEnd 脚本 ID"
    timeout_sec: 2400
